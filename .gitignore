lerna-debug.log*

# Diagnostic reports (next.js / node)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string substitution tasks
.grunt

# Bower dependency directory (https://bower.io)
bower_components

# node-modules (Папка зависимостей)
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables files (Секретные ключи и настройки окружения)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Но НЕ игнорируем шаблон для env-файлов, если он есть
!.env.example

# Development tools
.expo/
.config

# Vite build output (Папка готовой сборки)
dist/
dist-ssr/

# Vite cache directory (Кэш оптимизации зависимостей)
.vite/

# Prettier cache
.prettiercache

